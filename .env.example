# =====================================================================
#  VARIÁVEIS DE AMBIENTE — copie para .env.local e preencha.
#  Na Vercel: Project → Settings → Environment Variables.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL (sem /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (pode ficar visível no app)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase → Project Settings → API Keys → Secret key
# NUNCA coloque no código nem compartilhe. Só no .env.local e na Vercel.
# (usada a partir das Etapas 5–7, em operações exclusivas do servidor)
SUPABASE_SECRET_KEY=

# Cloudflare R2 (vídeos) — cadastre na Vercel; as duas chaves como "Sensitive"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dorama-lgbt-videos
